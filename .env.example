# Copy this file to .env for local development.
# Never commit real secrets.

# ─── CWA (中央氣象署 Open Data) ───────────────────────────────────────────────
# 用途：ETL 腳本 (src/Run-Etl.ps1) 呼叫 CWA API 抓取氣象站即時觀測資料
# 取得：https://opendata.cwa.gov.tw/userLogin
CWA_API_KEY=<YOUR_CWA_API_KEY>

# ─── CARTO (Basemap Tile Service) ─────────────────────────────────────────────
# 用途：前端地圖底圖 dark/light tile layer (web/src/map/MapManager.ts)
# 取得：https://carto.com/  → Dashboard → API Keys
# 注意：VITE_ 前綴讓 Vite 在 build 時把 key 注入前端 bundle
#       此 key 為 client-side tile 認證，CARTO 建議設定 domain restriction
VITE_CARTO_API_KEY=<YOUR_CARTO_API_KEY>
